{
  "name": "adezmold-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project unit --project web",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-bms \"vitest run --project rules --project integration\"",
    "test:e2e": "pnpm --filter @bms/functions build && pnpm --filter @bms/web build:emulator && firebase emulators:exec --only auth,firestore,functions,hosting --project demo-bms \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-bms --import ./.emulator-data --export-on-exit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "firebase-tools": "15.34.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
