# Server-side settings. Set these in Vercel → Project → Settings → Environment Variables.
# None of them are exposed to the browser (no VITE_ prefix). Never commit real values.

# --- Firebase (service account for the Admin SDK) ---
# From Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private key on one line; keep the literal \n sequences.
FIREBASE_PRIVATE_KEY=
# Web API key (Firebase console → Project settings → General). Used only by the
# server to check staff passwords for the lead register.
FIREBASE_WEB_API_KEY=

# --- Request protection ---
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
# Comma-separated list of the site's public addresses. Leave empty to allow same-host only.
ALLOWED_ORIGINS=

# --- Data protection ---
# Months before a lead is due for retention review (see docs/DATA.md).
LEAD_RETENTION_MONTHS=24
# Change whenever the privacy notice text changes.
PRIVACY_NOTICE_VERSION=2026-10

# --- Checklist download links ---
# Long random string used to sign download links (different from RATE_LIMIT_SALT).
# Required: without it the checklist form saves the lead but cannot give a download link.
DOWNLOAD_TOKEN_SECRET=

# --- Email (Resend) — optional until the domain is ready ---
# Leave RESEND_API_KEY empty and no emails are sent; leads record "not-configured".
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Adezmold Business Consulting <hello@yourdomain.com>"
EMAIL_FROM=
# Where replies from visitors should go (optional)
EMAIL_REPLY_TO=
# Who receives new-lead alerts (comma-separated)
LEAD_ALERT_TO=
# Public site address, e.g. https://yourdomain.com. Needed at BUILD time too: canonical links,
# LinkedIn/WhatsApp preview image, sitemap.xml. Also used for links inside emails.
SITE_URL=
