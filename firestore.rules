rules_version = '2';

// The browser never reads or writes Firestore directly.
// All lead data goes through the server (/api/*), which uses the Admin SDK and
// is not subject to these rules. Denying everything here means a leaked
// Firebase config or a crafted request from a browser can read or change nothing.
// Stage 6 (admin lead register) also goes through the server, so this stays closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
