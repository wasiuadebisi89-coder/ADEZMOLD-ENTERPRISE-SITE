rules_version = '2';

// Deny by default. Clients may read company data according to their membership and
// permissions; every write to company data goes through server commands
// (docs/bms/adr/0002-commands-only-writes.md). The Admin SDK bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function isActiveMember(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
        && memberDoc(companyId).data.status == 'active';
    }

    function can(companyId, permission) {
      return isActiveMember(companyId)
        && memberDoc(companyId).data.permissions.hasAny([permission]);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Users may keep their own display preferences; nothing security-relevant.
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource == null ? {} : resource.data)
             .affectedKeys().hasOnly(['displayName', 'preferences'])
        && (!('displayName' in request.resource.data)
             || (request.resource.data.displayName is string
                 && request.resource.data.displayName.size() <= 120))
        && (!('preferences' in request.resource.data)
             || request.resource.data.preferences is map);
      allow delete: if false;

      match /memberships/{companyId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
      match /{rest=**} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /invitations/{invitationId} {
      allow read: if can(resource.data.companyId, 'company.members.invite');
      allow write: if false;
    }

    match /companies/{companyId} {
      allow read: if isActiveMember(companyId);
      allow write: if false;

      match /members/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid)
          || can(companyId, 'company.members.read');
        allow write: if false;
      }

      match /roles/{roleId} {
        allow read: if isActiveMember(companyId);
        allow write: if false;
      }

      match /branches/{branchId} {
        allow read: if isActiveMember(companyId);
        allow write: if false;
      }

      match /settings/{docId} {
        allow read: if isActiveMember(companyId);
        allow write: if false;
      }

      match /fiscalYears/{fyId} {
        allow read: if can(companyId, 'settings.periods.read');
        allow write: if false;
      }

      match /periods/{periodId} {
        allow read: if can(companyId, 'settings.periods.read');
        allow write: if false;
      }

      match /approvalRequests/{requestId} {
        allow read: if can(companyId, 'approvals.read')
          || (isActiveMember(companyId) && resource.data.requestedBy == request.auth.uid);
        allow write: if false;
      }

      match /auditLogs/{entryId} {
        allow read: if can(companyId, 'company.audit.read');
        allow write: if false;
      }

      // Sales staff see the chart (no balances) to choose the cash or bank account paid into.
      match /accounts/{accountId} {
        allow read: if can(companyId, 'ledger.accounts.read')
          || can(companyId, 'sales.invoice.post')
          || can(companyId, 'sales.receipt.post');
        allow write: if false;
      }

      // Journals and ledger entries are read by bookkeepers and by financial report readers.
      match /journals/{journalId} {
        allow read: if can(companyId, 'ledger.journal.read')
          || can(companyId, 'reports.financial.read');
        allow write: if false;
      }

      match /ledgerEntries/{entryId} {
        allow read: if can(companyId, 'ledger.journal.read')
          || can(companyId, 'reports.financial.read');
        allow write: if false;
      }

      // Catalogue: anyone who works with products. Stock quantities and values reveal cost, so
      // they need stock report access; sales staff see quantities only, in stockAvailability.
      match /products/{productId} {
        allow read: if can(companyId, 'inventory.products.read');
        allow write: if false;
      }

      match /categories/{categoryId} {
        allow read: if can(companyId, 'inventory.products.read');
        allow write: if false;
      }

      match /locations/{locationId} {
        allow read: if isActiveMember(companyId);
        allow write: if false;
      }

      match /stockBalances/{balanceId} {
        allow read: if can(companyId, 'reports.stock.read');
        allow write: if false;
      }

      match /stockAvailability/{availabilityId} {
        allow read: if can(companyId, 'inventory.products.read')
          || can(companyId, 'sales.invoice.post')
          || can(companyId, 'reports.stock.read');
        allow write: if false;
      }

      match /stockMovements/{movementId} {
        allow read: if can(companyId, 'reports.stock.read');
        allow write: if false;
      }

      match /stockAdjustments/{adjustmentId} {
        allow read: if can(companyId, 'reports.stock.read')
          || can(companyId, 'inventory.adjustment.create')
          || can(companyId, 'inventory.count.create');
        allow write: if false;
      }

      // Purchasing: suppliers and their documents. Invoice-number keys stay server-only.
      match /suppliers/{supplierId} {
        allow read: if can(companyId, 'purchasing.read');
        allow write: if false;
      }

      match /goodsReceipts/{receiptId} {
        allow read: if can(companyId, 'purchasing.read');
        allow write: if false;
      }

      match /purchaseInvoices/{invoiceId} {
        allow read: if can(companyId, 'purchasing.read');
        allow write: if false;
      }

      match /supplierPayments/{paymentId} {
        allow read: if can(companyId, 'purchasing.read');
        allow write: if false;
      }

      match /supplierReturns/{returnId} {
        allow read: if can(companyId, 'purchasing.read');
        allow write: if false;
      }

      // Sales: tax codes for everyone in the company; customers for anyone who sells or takes
      // payments; documents for sales readers, or only one's own with sales.readOwn.
      function readsSale(companyId) {
        return can(companyId, 'sales.read')
          || (can(companyId, 'sales.readOwn') && resource.data.postedBy == request.auth.uid);
      }

      match /taxCodes/{taxCodeId} {
        allow read: if isActiveMember(companyId);
        allow write: if false;
      }

      match /customers/{customerId} {
        allow read: if can(companyId, 'sales.read')
          || can(companyId, 'sales.readOwn')
          || can(companyId, 'sales.invoice.post')
          || can(companyId, 'sales.receipt.post');
        allow write: if false;
      }

      match /salesInvoices/{invoiceId} {
        allow read: if readsSale(companyId);
        allow write: if false;
      }

      match /customerReceipts/{receiptId} {
        allow read: if readsSale(companyId);
        allow write: if false;
      }

      // Returns and refunds: raised by sales staff, who see only their own.
      function readsRaised(companyId) {
        return can(companyId, 'sales.read')
          || (can(companyId, 'sales.readOwn') && resource.data.createdBy == request.auth.uid);
      }

      match /creditNotes/{creditNoteId} {
        allow read: if readsRaised(companyId);
        allow write: if false;
      }

      match /customerRefunds/{refundId} {
        allow read: if readsRaised(companyId);
        allow write: if false;
      }

      // Bank reconciliation: for those who read the ledger or reconcile.
      function readsBank(companyId) {
        return can(companyId, 'ledger.journal.read') || can(companyId, 'ledger.bank.reconcile');
      }

      match /bankStates/{accountId} {
        allow read: if readsBank(companyId);
        allow write: if false;
      }

      match /bankReconciliations/{reconciliationId} {
        allow read: if readsBank(companyId);
        allow write: if false;
      }

      match /bankClearings/{entryId} {
        allow read: if readsBank(companyId);
        allow write: if false;
      }

      // Fixed assets: the register and depreciation runs, posted only by server commands.
      match /fixedAssets/{assetId} {
        allow read: if can(companyId, 'assets.read');
        allow write: if false;
      }

      match /depreciationRuns/{runId} {
        allow read: if can(companyId, 'assets.read');
        allow write: if false;
      }

      match /attachments/{attachmentId} {
        allow read: if isActiveMember(companyId);
        allow write: if false;
      }

      // Idempotency records and anything not listed above: server only.
      match /{rest=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
