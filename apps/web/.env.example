# Firebase web config for the target project (public by design; never put secrets here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=europe-west1
# reCAPTCHA Enterprise site key for App Check (staging/production only).
VITE_APPCHECK_SITE_KEY=
# true connects to the local Firebase emulators.
VITE_USE_EMULATORS=false
